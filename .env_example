# 第三方对接与密钥。复制为 .env 后按需填写。不要提交填了密钥的 .env。
# 读取顺序：进程环境变量 → 本仓 .env。不读别的仓的 .env（2026-10-10 拆掉外仓兜底，TODO P2·25）。

DEEPSEEK_API_KEY=
CHAT_API_URL=https://api.deepseek.com/v1/chat/completions
CHAT_MODEL_NAME=deepseek-flash
EMBED_API_URL=http://127.0.0.1:8030/v1/embeddings
EMBED_API_KEY=

# 决策模型服务（service/kev08/ 下的 probe_kev08.py）用；只作调研，不是线上主路径的依赖。
# 任何 Jev 式端点都行：本地 Kev / laya-serve / StartLux，或托管 Jev。KEY 留空表示不鉴权。
KEV_BASE_URL=http://127.0.0.1:8034
KEV_API_KEY=
KEV_MODEL=kev-latest

